{
  "name": "knowledge-forge",
  "version": "0.1.0",
  "description": "Universal knowledge ingestion library for AI systems",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "node --test",
    "dev": "tsc --watch",
    "clean": "rm -rf dist/",
    "lint": "eslint src/",
    "format": "prettier --write src/"
  },
  "keywords": [
    "knowledge",
    "rag",
    "vector-database",
    "embeddings",
    "pdf",
    "markdown",
    "documentation",
    "ai",
    "multi-ai",
    "consensus"
  ],
  "author": "FlossWare (sfloess)",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://gitlab.cee.redhat.com/sfloess/knowledge-forge"
  },
  "dependencies": {
    "chromadb": "^1.10.5",
    "@xenova/transformers": "^2.17.2",
    "consensus-ai": "file:../../consensus-ai/javascript"
  },
  "optionalDependencies": {
    "pdf-parse": "^1.1.1",
    "markdown-it": "^13.0.1",
    "jsdom": "^22.1.0",
    "js-yaml": "^4.1.0",
    "@iarna/toml": "^2.2.5",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
